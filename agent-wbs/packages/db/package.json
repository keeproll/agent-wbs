{
  "name": "@awbs/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "awbs-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node ../../scripts/vitest.ts --config ../../vitest.config.ts",
    "migrate": "node --env-file-if-exists=../../.env --conditions=awbs-source src/migrate-cli.ts",
    "generate": "drizzle-kit generate",
    "seed:system": "node --env-file-if-exists=../../.env --conditions=awbs-source src/seed-cli.ts system",
    "seed:demo": "node --env-file-if-exists=../../.env --conditions=awbs-source src/seed-cli.ts demo"
  },
  "dependencies": {
    "@awbs/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "drizzle-kit": "0.31.11"
  }
}
