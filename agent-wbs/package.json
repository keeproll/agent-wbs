{
  "name": "agent-wbs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "env:init": "node scripts/env-init.ts",
    "dev": "pnpm --parallel --filter @awbs/api --filter @awbs/web run dev",
    "build": "pnpm -r run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/vitest.ts --config vitest.config.ts",
    "test:db": "node scripts/vitest.ts --config vitest.db.config.ts",
    "test:scenario": "node scripts/vitest.ts --config vitest.scenario.config.ts",
    "e2e": "pnpm --filter @awbs/web test:e2e",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "openapi:generate": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check",
    "db:migrate": "pnpm --filter @awbs/db run migrate"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.65.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
