{
  "name": "@awbs/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "node --env-file-if-exists=../../.env --conditions=awbs-source src/platform/auth-cli.ts",
    "dev": "node --env-file-if-exists=../../.env --conditions=awbs-source --watch src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json && node --conditions=awbs-source scripts/copy-pdf-assets.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node ../../scripts/vitest.ts --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@awbs/db": "workspace:*",
    "@awbs/shared": "workspace:*",
    "@fastify/ajv-compiler": "4.0.8",
    "fastify": "5.12.8",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "playwright-core": "1.65.1"
  },
  "devDependencies": {
    "pretendard-gov": "1.3.9"
  }
}
