# `pnpm env:init`이 CHANGE_ME를 채워 .env를 만든다. .env는 커밋하지 않는다.
AWBS_DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://awbs_owner:CHANGE_ME@127.0.0.1:25442/awbs_dev
# 테스트는 DB 이름이 awbs_test_로 시작하지 않으면 실행되지 않는다. worktree마다 다른 이름을 쓴다.
TEST_DATABASE_URL=postgres://awbs_owner:CHANGE_ME@127.0.0.1:25442/awbs_test_CHANGE_SLUG
DB_POOL_MAX=10
AWBS_HOST=127.0.0.1
AWBS_PORT=3100
AWBS_WEB_PORT=5173
# Origin은 브라우저 주소의 출처(프로토콜·호스트·포트)다. 다른 사이트의 변경 요청을 막는다.
# 개발 화면을 사용할 때: AWBS_ORIGIN=http://127.0.0.1:5173
# LAN은 AWBS_ALLOW_LAN=true와 실제 접속 Origin을 설정하고 auth set-password를 먼저 실행한다.
# AWBS_ORIGIN을 생략하면 API 주소(http://AWBS_HOST:AWBS_PORT)를 쓴다.
LOG_LEVEL=info
