# `pnpm env:init`이 CHANGE_ME를 채워 .env를 만든다. .env는 커밋하지 않는다.
AWBS_DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://awbs_owner:CHANGE_ME@127.0.0.1:25442/awbs_dev
# 테스트는 DB 이름이 awbs_test_로 시작하지 않으면 실행되지 않는다. worktree마다 다른 이름을 쓴다.
TEST_DATABASE_URL=postgres://awbs_owner:CHANGE_ME@127.0.0.1:25442/awbs_test_CHANGE_SLUG
DB_POOL_MAX=10
AWBS_HOST=127.0.0.1
AWBS_PORT=3100
AWBS_WEB_PORT=5173
LOG_LEVEL=info
