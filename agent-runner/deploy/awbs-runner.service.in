# Agent WBS Runner — systemd 사용자 서비스(M8-06). 직접 고치지 말고 install-runner-service.sh로 만든다.
# @NAME@ 같은 자리표시는 설치 스크립트가 실제 값으로 바꾼다.
# 설명서: docs/ops/operations.md 「Runner 서비스」
[Unit]
Description=Agent WBS Runner (@NAME@)
Documentation=file://@REPO@/docs/ops/operations.md
# 5분 안에 다섯 번 넘게 죽으면 더 다시 켜지 않는다. 왜: 설정 오류로 무한히 재시작하며 로그만 쌓는 일을 막는다.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@/agent-runner
# 사용자 systemd의 기본 PATH에는 nvm의 node가 없다. node 폴더를 맨 앞에 둔다. git·gh·docker·sudo·systemd-run은 /usr/bin에 있다.
Environment=PATH=@NODE_DIR@:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
# Agent 전용 OS 계정 격리(Q-08 B). .env보다 이 값이 먼저다(node --env-file은 이미 있는 환경 변수를 바꾸지 않는다).
Environment=AWBS_AGENT_USER=awbs-agent
# 비밀값(AWBS_RUNNER_TOKEN 등)은 agent-runner/.env(권한 0600)에서만 읽는다. 이 파일에는 넣지 않는다.
ExecStart=@NODE@ --env-file=@REPO@/agent-runner/.env src/main.ts
# 종료 신호는 Runner 본체에만 먼저 보낸다. Runner가 진행 중인 보고를 정리하고 끝낼 시간을 준다.
# 시간이 지나도 남은 프로세스는 강제로 끝낸다. Agent 세션은 Runner가 만든 별도 scope라 여기 포함되지 않는다.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
# 새로 만드는 파일은 Runner 계정만 읽는다.
UMask=0077
# NoNewPrivileges는 일부러 켜지 않는다. 왜: Runner는 sudo로 Agent 실행 래퍼(/usr/local/libexec/awbs-agent-exec) 하나를 부른다.
# NoNewPrivileges를 켜면 sudo가 막혀 Agent를 전용 계정으로 실행하지 못한다(agent-runner/docs/isolation.md).

[Install]
WantedBy=default.target
