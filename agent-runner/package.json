{
  "name": "agent-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "node scripts/vitest.ts",
    "test:design-contract": "node scripts/vitest.ts --config vitest.design-contract.config.ts",
    "test:cli-update:real": "node --test test/cli-update/npm.real.ts",
    "test:github:real": "node scripts/github.real.ts",
    "client:generate": "node scripts/client.ts",
    "client:check": "node scripts/client.ts --check",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "libpg-query": "18.2.5",
    "pgsql-ast-parser": "12.0.2",
    "pgsql-parser": "18.4.5",
    "pino": "10.4.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
