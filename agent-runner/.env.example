# 복사해 .env를 만든다(권한 0600). .env는 커밋하지 않는다.
AWBS_URL=http://127.0.0.1:3100
# Agent WBS에서 발급한 Runner 토큰(발급 명령은 M2에서 제공)
AWBS_RUNNER_TOKEN=
# 비우면 ~/.agentwbs
AWBS_HOME=
LOG_LEVEL=info
# 시스템 커밋용 공개 설정. 세 항목을 함께 설정한다. 개인키는 파일에 넣지 않는다.
AWBS_SYSTEM_DEPLOY_KEY_ID=
AWBS_SYSTEM_SSH_AUTH_SOCK=
AWBS_SYSTEM_SSH_KNOWN_HOSTS=
# Agent 전용 OS 계정 격리(Q-08). scripts/isolation/setup-agent-user.sh로 설치한 뒤 awbs-agent를 넣는다(고정값).
# 비어 있으면 Runner는 실제 Agent 실행 계획을 만들지 않는다(격리 미정과 같음). 작업 영역·래퍼 경로는 고정이다.
AWBS_AGENT_USER=
